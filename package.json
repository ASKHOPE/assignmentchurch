{
  "name": "assignmentschurch",
  "version": "1.0.0",
  "type": "module",
  "description": "Ultra-fast mobile-first church agenda web application with Bun, SQLite, and WhatsApp curation",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "deploy": "wrangler deploy",
    "worker:dev": "wrangler dev",
    "d1:create": "wrangler d1 create assignmentchurch-db",
    "d1:init": "wrangler d1 execute assignmentchurch-db --remote --file=./schema.sql",
    "d1:init:local": "wrangler d1 execute assignmentchurch-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/bun": "latest",
    "playwright": "^1.63.0",
    "wrangler": "^4.131.1"
  }
}
