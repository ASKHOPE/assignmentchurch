{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "assignmentchurch",
  "main": "./src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
